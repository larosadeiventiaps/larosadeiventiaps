# ── Gli indirizzi del sito vecchio ─────────────────────────────
#
# Il 29/08/2026 il sito nuovo prende il posto di quello WordPress. La sitemap
# del vecchio dichiarava **31 indirizzi**, che oggi stanno nella memoria di
# Google e nei preferiti delle persone: senza queste righe finirebbero tutti
# sulla pagina «non trovata».
#
# ⚠️ Un 301 dice «si e' spostato per sempre», e i motori trasferiscono al nuovo
#    indirizzo quel che il vecchio si era guadagnato. Un 302 no.
# ⚠️ L'ordine conta: `RedirectMatch` guarda le regole dall'alto. Le pagine
#    nostre finiscono in `.html`, i vecchi indirizzi no — per questo nessuna di
#    queste regole puo' agganciare per sbaglio una pagina di adesso.
<IfModule mod_alias.c>
  # Il contenitore dei progetti e ogni singolo progetto
  RedirectMatch 301 ^/progetti(/.*)?/?$        /progetti.html
  # Le notizie diventano gli eventi
  RedirectMatch 301 ^/news/?$                  /eventi.html
  # Pagine di servizio che hanno un corrispondente preciso
  RedirectMatch 301 ^/dona-il-5-x-1000/?$      /sostienici.html
  RedirectMatch 301 ^/estratto-dallo-statuto/?$ /documenti.html
  # Le feste e le serate: erano eventi, sono eventi
  RedirectMatch 301 ^/aperipizza/?$            /eventi.html
  RedirectMatch 301 ^/brindisi-di-natale-per-la-rosa-dei-venti/?$ /eventi.html
  RedirectMatch 301 ^/its-movie-time(-[0-9]+)?/?$ /eventi.html
  # Le attivita' con le persone: sono progetti
  RedirectMatch 301 ^/a-s-passo-con-la-cultura/?$ /progetti.html
  RedirectMatch 301 ^/giocare-con-linglese/?$  /progetti.html
  RedirectMatch 301 ^/laboratorio-musica-movimento/?$ /progetti.html
  RedirectMatch 301 ^/flow/?$                  /progetti.html
  # Restano due indirizzi senza un erede naturale: una campagna del 2020 e una
  # pagina che WordPress aveva chiamato col suo numero interno. Vanno a casa.
  RedirectMatch 301 ^/campagna-associazioni-ottobre-2020/?$ /
  RedirectMatch 301 ^/896-2/?$                 /
</IfModule>

# Error pages
ErrorDocument 404 /404.html

# Disable directory listing
Options -Indexes

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------
# HTTPS obbligatorio dentro questa cartella - 25/08/2026
# ------------------------------------------------------------------
# Da oggi due moduli di questo sito (candidature e richieste di
# informazioni) parlano con il gestionale su rdv.nextum.it, che e' un altro
# dominio: il browser li lascia passare solo se l'api dichiara l'origine di
# chi chiama fra quelle ammesse. Le origini ammesse sono le DUE in https
# (con e senza www): da una pagina aperta in http:// l'origine non combacia,
# la richiesta viene scartata dal browser e il modulo ripiega in silenzio
# sull'email. Nessun errore, nessuna traccia, e la sensazione che il
# collegamento col gestionale non serva a niente.
# ⚠️ Il sito rispondeva in chiaro senza rimandare da nessuna parte
# (verificato: http://larosadeiventiaps.org/nuovo/ dava 200, non un 301).
# Serve comunque, moduli a parte: qui si scrivono nome, email e telefono.
<IfModule mod_rewrite.c>
	RewriteEngine On
	# HTTPS=on non basta dietro un proxy che termina TLS: si guarda anche
	# l'intestazione che quel proxy lascia. Senza la seconda condizione si
	# rischia un ciclo di rimandi infinito su un sito che era gia' sicuro.
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https
	RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Chi entra nella ricerca, e chi no ─────────────────────────────────
#
# Deciso dal titolare il 29/08/2026, appena il sito e' andato online al posto
# del vecchio: **le pagine si trovano su Google, le fotografie no.**
#
# Fino a quel giorno il sito mandava `noindex` su tutto, perche' viveva in una
# sottocartella di prova. Adesso e' il sito dell'associazione: se restasse
# nascosto, chi cerca «La Rosa dei Venti Bagno a Ripoli» non lo troverebbe.
#
# ⛔⛔ **Le immagini restano fuori, ed e' il motivo per cui siamo su questo
#    server.** Sono fotografie di persone con disabilita': dentro il sito
#    hanno il loro contesto — il progetto, la data, la didascalia — in Google
#    Immagini no. Su Ergonet questa riga NON arrivava sugli allegati statici
#    (misurato il 29/08/2026: le pagine sì, le foto no), e non poterla far
#    rispettare e' stata la ragione del trasloco. Qui arriva: verificato il
#    29/08/2026 su `images/`, `documenti/`, CSS e JS.
#
# ⚠️ `noimageindex` su una PAGINA dice «non indicizzare le immagini che
#    contiene»; sui FILE immagine e' l'intestazione qui sotto che conta. Servono
#    tutte e due: una pagina trovabile che rimanda a una foto trovabile
#    rimetterebbe le foto in circolazione dalla porta di servizio.
#
# ⚠️ `Header always set`, non `Header set`: senza `always` l'intestazione non
#    finisce sulle risposte servite fuori dal giro normale — ed e' esattamente
#    li' che passavano le immagini.
<IfModule mod_headers.c>
	# Le pagine: trovabili, ma senza portarsi dietro le foto.
	<FilesMatch "\.html$">
		Header always set X-Robots-Tag "index, follow, noimageindex"
	</FilesMatch>

	# Foto, disegni, documenti e file di servizio: fuori dai risultati.
	# ⚠️ `.xml` NON e' in elenco apposta: l'unico file xml e' `sitemap.xml`,
	#    che ai motori deve arrivare leggibile. Nasconderlo vorrebbe dire
	#    dichiarare una mappa e poi impedire di aprirla.
	<FilesMatch "\.(jpe?g|png|gif|webp|svg|avif|pdf|css|js|json)$">
		Header always set X-Robots-Tag "noindex, noimageindex"
	</FilesMatch>
</IfModule>

# ⚠️ Qui c'era un secondo `ErrorDocument` verso /nuovo/404.html, che
# serviva finche' il sito stava in sottocartella su Ergonet. Tolto il 29/08/2026,
# quando il sito e' passato a Serverplan **alla radice del dominio**: vale quello
# in cima al file. In Apache vince l'ultimo, ed era per questo che restava sotto.

# ⚠️ Le pagine e i dati NON si tengono in cache. Questa e' una versione che
# si guarda per correggerla: con la cache si rivedrebbe sempre la stessa
# pagina vecchia senza capire perche'.
<IfModule mod_headers.c>
	<FilesMatch "\.(html|json)$">
		Header set Cache-Control "no-store, must-revalidate"
	</FilesMatch>
</IfModule>

# ✅ Questo blocco ADESSO ha effetto. Su Ergonet non l'aveva: le immagini
# uscivano con `max-age=10368000` (120 giorni) perche' davanti c'era un
# server che consegnava i file statici da se' e non leggeva questo file.
# Dal 29/08/2026 il sito e' su Serverplan, dove le immagini le serve Apache:
# misurato lo stesso giorno, `images/logo-rdv.png` risponde con
# `no-cache, must-revalidate`. ⇒ La cache delle immagini si governa di nuovo
# da qui.
# ⚠️ Resta valido `?v=...` (`VERSIONE_IMMAGINI` in `js/main.js`) come
#    seconda cintura: non fa male, e serve se un giorno si torna a tenere le
#    immagini a lungo.
#
# Il 23/08/2026 sei
# loghi dei partner sono stati sostituiti mantenendo lo stesso nome di file
# (comune-bagno-a-ripoli, croce-doro-ponte-ema, croce-rossa-italiana,
# misericordia-badia, sds-firenze-sudest, trekking-bar): col «tieni per
# quattro mesi» del blocco qui sopra, chi aveva aperto la pagina il giorno
# prima ha continuato a vedere i loghi vecchi, senza nessun modo di
# accorgersene ne' di rimediare dal server. «no-cache» non vuol dire «non
# tenere»: il file resta nella cache del browser, ma prima di riusarlo il
# browser chiede al server se e' cambiato — se non lo e' torna un 304 da
# poche decine di byte, quindi il risparmio di banda che il blocco sopra
# cercava resta. Quando il sito prendera' il posto di quello principale e i
# contenuti non cambieranno piu' ogni giorno, questo blocco va tolto e
# le immagini tornano a essere tenute a lungo — ma allora un logo sostituito
# dovra' cambiare nome, o il problema torna identico.
# ⛔⛔ **Il guasto del 29/08/2026, e perche' `js` e `css` sono in elenco.**
# Le pagine escono con `no-store` (arrivano sempre nuove), ma il foglio di
# stile e gli script uscivano con `max-age` di un mese. Quel giorno ho tolto
# dalle pagine i due campi data e ho cambiato `main.js` di conseguenza: chi
# aveva gia' visitato il sito si e' ritrovato la **pagina nuova** insieme al
# **codice vecchio**, che quei campi li cercava ancora. `dateFrom.value` su
# `null` e' un errore che ferma tutto: Progetti, Eventi e Galleria hanno
# smesso di mostrare qualunque cosa. Nessun errore lato server, il sito
# rispondeva 200 a tutto: se ne e' accorto il titolare guardandolo.
# ⇒ Con `no-cache` il browser il file lo tiene, ma prima di riusarlo chiede
#   se e' cambiato: se non lo e' torna un 304 di poche decine di byte, quindi
#   il risparmio resta e la pagina non puo' piu' finire disallineata dal suo
#   codice.
# ⚠️ Il timbro `?v=...` (`scripts/versiona-asset.py`) resta e va comunque
#    lanciato: e' la difesa che funziona anche dove `.htaccess` non arriva.
#    Quel giorno non l'avevo lanciato, ed e' stata la causa prima.
<IfModule mod_headers.c>
	<FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|css|js)$">
		Header set Cache-Control "no-cache, must-revalidate"
		Header unset Expires
	</FilesMatch>
</IfModule>

# ⛔ Gli script di sincronizzazione da Excel finiscono online insieme al
# sito, e il server li servirebbe in chiaro: non contengono segreti, ma
# raccontano com'e' fatta la cartella OneDrive dell'associazione e come si
# generano i dati. Non e' roba che si mette in mano a chi passa.
<FilesMatch "\.(py|xlsx?|md)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
